# WS_AUTH_TIMEOUT_SECONDS=10
# WS_MAX_FRAMES_PER_MINUTE=240
# COMMAND_TIMEOUT_SECONDS=15
# STATE_REQUEST_TIMEOUT_SECONDS=10
# STATE_REFRESH_MIN_INTERVAL_SECONDS=3
