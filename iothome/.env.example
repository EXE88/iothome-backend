# Copy to .env and fill in. Never commit the real .env.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Also the allowlist for where the payment callback may send the browser back
# to. Add every origin the frontend is genuinely served from, and nothing else.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Defaults to sqlite when unset. With the dev docker-compose stack:
# DATABASE_URL=postgres://iothome:iothome-dev-password@localhost:5432/iothome
# DATABASE_URL=

REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND fall back to REDIS_URL.

# Session lifetimes. The frontend's REFRESH_COOKIE_MAX_AGE_DAYS must match
# REFRESH_TOKEN_LIFETIME_DAYS.
# The refresh window is absolute, not sliding: rotation is off, so seven days
# after signing in the user signs in again. Logging out blacklists the token,
# which is what makes a logout apply to every browser holding it.
ACCESS_TOKEN_LIFETIME_MINUTES=1440
REFRESH_TOKEN_LIFETIME_DAYS=7

# How long an order may sit unpaid before the sweep releases its stock. The
# buyer who closes the gateway tab sends no signal, so only time distinguishes
# them from one still typing a card number — keep this well clear of a real
# checkout. Needs the Celery worker and beat to be running.
PENDING_ORDER_TIMEOUT_MINUTES=30

# How long an account that never verified its address keeps that address before
# it is deleted. It can do nothing while it exists — it cannot even log in — so
# this is really "how long we hold the address for someone who walked away".
UNVERIFIED_ACCOUNT_TTL_DAYS=1

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For SMTP later:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=IoT Home <no-reply@iothome.dev>

# The sandbox accepts any UUID as a merchant id — generate one and paste it in.
# Sandbox authorities come back starting with "S". Swap in the real merchant id
# from the Zarinpal panel when ZARINPAL_SANDBOX goes False.
# https://www.zarinpal.com/docs/paymentGateway/sandBox.html
#   python -c "import uuid; print(uuid.uuid4())"
ZARINPAL_SANDBOX=True
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=http://127.0.0.1:8000/api/purchases/payments/verify/
# Where the gateway callback bounces the browser once the result is known.
FRONTEND_PAYMENT_RESULT_URL=http://127.0.0.1:3000/checkout/result

